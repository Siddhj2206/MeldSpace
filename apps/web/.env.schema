# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url
VITE_SERVER_URL=

# Signaling server URL. Optional: when unset the client derives
# ws(s)://<current-host>:4444, which is correct for the LAN demo.
# @public @type=url @optional
VITE_SIGNALING_URL=

# Optional STUN server for ICE when peers are on different networks.
# @public @optional
VITE_STUN_URL=

# Self-hosted TURN relay fallback (#19). Content-blind: relays encrypted
# DTLS only. Unset = LAN-only path, exactly today's behaviour.
# @public @type=url @optional
VITE_TURN_URL=

# @public @optional
VITE_TURN_USERNAME=

# @sensitive @optional
VITE_TURN_CREDENTIAL=
